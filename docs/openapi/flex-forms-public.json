{
  "openapi": "3.1.0",
  "info": {"title": "Flex Forms Public API", "version": "1.0.0"},
  "paths": {
    "/flex-forms/analytics/beacon": {
      "post": {
        "summary": "Ingest Insights beacon batch",
        "operationId": "postAnalyticsBeacon",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "events": {"type": "array", "items": {"type": "object"}}
                }
              }
            }
          }
        },
        "responses": {"202": {"description": "Accepted"}}
      }
    }
  }
}
